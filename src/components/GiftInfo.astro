<div class="gift-container">
  <div class="gift-heading">
    <img
      src="/regalo.svg"
      alt=""
      class="gift-heading-icon"
      aria-hidden="true"
    />
    <h2>Regalos</h2>
  </div>
  <p>
    Tu presencia es nuestro regalo principal. Si deseas tener un detalle
    adicional, puedes hacerlo por cualquiera de estas opciones.
  </p>

  <div class="gift-grid">
    <article class="gift-card">
      <h3>Pago Móvil</h3>
      <p>
        <strong>Banco:</strong> Banesco<br />
        <strong>C.I:</strong> 23.597.179<br />
        <strong>Tlf:</strong> 04129158382
      </p>
      <div class="gift-actions">
        <button
          type="button"
          class="copy-btn"
          data-copy={"Banesco\nC.I: 23.597.179\nTlf: 04129158382"}
          data-label="Copiar datos">Copiar datos</button
        >
      </div>
    </article>

    <article class="gift-card">
      <h3>Binance</h3>
      <p>
        <strong>Correo:</strong> dariannavento@gmail.com<br />
        <strong>Usuario:</strong> Darianna8
      </p>
      <div class="gift-actions">
        <button
          type="button"
          class="copy-btn"
          data-copy="dariannavento@gmail.com"
          data-label="Copiar correo">Copiar correo</button
        >
      </div>
    </article>

    <article class="gift-card">
      <h3>Lluvia de sobres</h3>
      <p>
        También recibiremos sobres el día del evento. No es obligatorio: con tu
        compañía ya estamos felices.
      </p>
      <p class="gift-note">
        Gracias por acompañarnos en este momento tan especial.
      </p>
    </article>
  </div>
</div>

<style>
  .gift-container {
    max-width: none;
    margin: 0;
    padding: 1.9rem 1.55rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 0;
    box-shadow: var(--shadow-sm);
  }

  .gift-container > p {
    text-align: center;
  }

  .gift-heading {
    width: 100%;
    display: grid;
    justify-items: center;
    justify-content: center;
    gap: 0.35rem;
  }

  .gift-heading-icon {
    width: 52px;
    height: 52px;
    animation: gift-bob 4.4s ease-in-out infinite;
  }

  .gift-grid {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (max-width: 1024px) {
    .gift-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .gift-grid {
      grid-template-columns: 1fr;
    }
  }

  .gift-card {
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 1.2rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .gift-card h3 {
    margin-bottom: 0.35rem;
  }

  .gift-card p {
    margin: 0;
    font-size: 1.12rem;
  }

  .gift-actions {
    margin-top: 0.35rem;
  }

  .copy-btn {
    font-size: 1rem;
  }

  .gift-note {
    font-size: 0.95rem;
    color: var(--muted);
    margin: 0;
  }

  @keyframes gift-bob {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    25% {
      transform: translateY(-4px) rotate(-3deg);
    }
    75% {
      transform: translateY(-2px) rotate(3deg);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy ?? "";
      const label = btn.dataset.label ?? "Copiar";
      let ok = false;
      try {
        await navigator.clipboard.writeText(text);
        ok = true;
      } catch {
        // Respaldo para navegadores sin permiso de portapapeles.
        const ta = document.createElement("textarea");
        ta.value = text;
        ta.style.position = "fixed";
        ta.style.opacity = "0";
        document.body.appendChild(ta);
        ta.select();
        try {
          ok = document.execCommand("copy");
        } catch {}
        ta.remove();
      }
      btn.textContent = ok ? "¡Copiado!" : "No se pudo copiar";
      setTimeout(() => (btn.textContent = label), 1800);
    });
  });
</script>
