---
// La URL del QR se deriva del dominio configurado en astro.config.mjs (`site`).
const photoUploadUrl = new URL("/fotos", Astro.site).toString();
const qrImageUrl = `https://quickchart.io/qr?text=${encodeURIComponent(photoUploadUrl)}&size=280`;
---

<div class="qr-section">
  <div class="qr-heading">
    <span class="qr-camera" aria-hidden="true">
      <img src="/camara.svg" alt="" class="qr-heading-icon" />
      <img src="/camara_flash.svg" alt="" class="qr-heading-icon-flash" />
    </span>
    <h2>Comparte tus Fotos</h2>
  </div>
  <p>Escanéalo desde tu celular para subir fotos del evento en segundos.</p>

  <div class="qr-container">
    <img
      class="qr-image"
      src={qrImageUrl}
      alt="Código QR para subir fotos del evento"
      loading="lazy"
    />
  </div>

  <a href="/fotos" class="qr-upload-btn">
    <img src="/camara.svg" alt="" class="qr-upload-btn-icon" aria-hidden="true" />
    Subir fotos
  </a>

  <p class="qr-note">
    Escanea el código o pulsa el botón para subir tus fotos del evento.
  </p>
</div>

<style>
  .qr-section {
    text-align: center;
    padding: 1.6rem;
    background: var(--surface);
    border-radius: 0;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    max-width: none;
    margin: 0;
  }

  .qr-container {
    margin: 1.1rem auto 0;
    padding: 1.2rem;
    max-width: 380px;
    background: var(--surface-soft);
    border-radius: 0;
    border: 1px solid var(--line);
  }

  .qr-heading {
    width: 100%;
    display: grid;
    justify-items: center;
    gap: 0.3rem;
  }

  .qr-camera {
    position: relative;
    width: 64px;
    height: 64px;
    display: inline-block;
  }

  .qr-heading-icon,
  .qr-heading-icon-flash {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
  }

  .qr-heading-icon-flash {
    opacity: 0;
    animation: qr-camera-flash 2.4s ease-in-out infinite;
  }

  .qr-image {
    width: min(280px, 70vw);
    height: auto;
    border: 8px solid var(--surface);
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.25);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .qr-image:hover {
    transform: scale(1.03);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(212, 175, 55, 0.2);
  }

  .qr-link {
    margin-top: 1rem;
    word-break: break-all;
    font-size: 1.05rem;
  }

  .qr-note {
    margin-top: 0.9rem;
    font-size: 1.05rem;
    color: var(--muted);
  }

  .qr-upload-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.1rem;
    padding: 0.8rem 1.6rem;
    border-radius: 999px;
    background: var(--primary);
    border: 1px solid var(--primary);
    color: #1a1508;
    font-weight: 700;
    font-size: 1.15rem;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease;
  }

  .qr-upload-btn:hover {
    transform: translateY(-2px);
    background: #E8C84A;
    box-shadow: 0 6px 20px rgba(212, 175, 55, 0.35);
  }

  .qr-upload-btn-icon {
    width: 20px;
    height: 20px;
    object-fit: contain;
    filter: brightness(0) saturate(100%) invert(10%) sepia(20%) saturate(800%) hue-rotate(5deg);
  }

  @keyframes qr-camera-flash {
    0%,
    70%,
    100% {
      opacity: 0;
    }
    75% {
      opacity: 0.6;
    }
    80% {
      opacity: 1;
    }
    85% {
      opacity: 0.3;
    }
    90% {
      opacity: 1;
    }
    95% {
      opacity: 0;
    }
  }
</style>
