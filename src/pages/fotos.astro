---
import BaseLayout from "../layouts/BaseLayout.astro";
import PhotoUpload from "../components/PhotoUpload.astro";
---

<BaseLayout title="Subir Fotos" skipPrivacyGate={true}>
  <main class="fotos-main">
    <header class="fotos-header">
      <a href="/" id="back-link" class="back-link">← Volver a la invitación</a>
      <h1>Comparte tus Fotos</h1>
      <p class="fotos-sub">
        Captura los momentos especiales del evento y compártelos con nosotros.
      </p>
    </header>

    <section class="fotos-section">
      <PhotoUpload />
    </section>
  </main>
</BaseLayout>

<script>
  // "Volver a la invitación" debe regresar con el código que el invitado
  // ingresó antes (lo tomamos de la URL actual o de localStorage).
  const backLink = document.getElementById("back-link") as HTMLAnchorElement | null;
  if (backLink) {
    const params = new URLSearchParams(window.location.search);
    let code = params.get("codigo")?.trim() || params.get("token")?.trim() || "";
    if (!code) {
      try {
        code = localStorage.getItem("weddingGuestCode")?.trim() || "";
      } catch {}
    }
    if (code) {
      backLink.href = `/?codigo=${encodeURIComponent(code)}`;
    }
  }
</script>

<style>
  .fotos-main {
    min-height: 100vh;
    padding: 2rem 1rem 3rem;
    max-width: 760px;
    margin-inline: auto;
  }

  .fotos-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 1.2rem;
    color: var(--primary);
    font-size: 1.05rem;
    text-decoration: none;
    font-weight: 600;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .fotos-sub {
    margin-bottom: 0.75rem;
    font-size: 1.2rem;
  }

  .fotos-section {
    width: 100%;
  }
</style>

